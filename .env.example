# .env.example
# Copia este archivo a .env y configura tus propias credenciales

# API Configuration
VITE_API_URL=http://localhost:3001/api
VITE_USE_REAL_API=false

# Google Maps API
VITE_GOOGLE_MAPS_API_KEY=tu_google_maps_api_key_aqui

# Supabase Configuration
# Obtén estas credenciales de tu proyecto en https://supabase.com/dashboard
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu_clave_anonima_aqui

# Para el sistema de autenticación, asegúrate de tener estas tablas:
# - profiles: id (uuid), email (text), name (text), role (text), phone (text), created_at (timestamp)
#
# Roles disponibles:
# - "user": Usuario normal del sistema
# - "admin": Administrador con acceso al panel de control
#
# Usuarios de prueba sugeridos:
# - pablitopacheco051@gmail.com (role: admin)
